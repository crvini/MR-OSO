# =====================================================
# 1) Copia este archivo:   cp .env.example .env
# 2) Pega tu API key de Anthropic abajo
# 3) Consíguela en:        https://console.anthropic.com/settings/keys
# =====================================================

ANTHROPIC_API_KEY=

# Puerto del backend local (opcional, default 3001)
PORT=3001

# Orígenes permitidos para /api/chat, separados por coma.
# Vacío = endpoint abierto. En producción (Vercel/Netlify) configúralo
# con la URL real del sitio para que nadie más consuma tu API key.
# Ej: ALLOWED_ORIGINS=https://mr-oso.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=
